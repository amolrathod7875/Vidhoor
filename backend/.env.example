# ===== Core =====
CEREBRAS_API_KEY=
# CHROMA_HOST is only needed when running inside Docker Compose (use "chroma").
# When running uvicorn directly on the host, leave CHROMA_HOST unset to use the default 127.0.0.1.
CHROMA_HOST=
CHROMA_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FIREBASE_SERVICE_ACCOUNT_PATH=
SHARE_LINK_SECRET=

# ===== Oracle DB =====
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_CONFIG_DIR=/app/wallet
ORACLE_WALLET_LOCATION=/app/wallet
ORACLE_WALLET_PASSWORD=

# ===== Public link settings =====
APP_PUBLIC_BASE_URL=http://127.0.0.1:8001
LEGAL_SOURCE_BASE_URL=

# ===== Indian Kanoon =====
ENABLE_INDIAN_KANOON_LINKS=true
INDIAN_KANOON_MAX_LINKS=3
INDIAN_KANOON_TRIGGER_MODE=case_queries

# ===== OCR =====
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
OCR_SPACE_TIMEOUT_SECONDS=45
OCR_SPACE_MAX_RETRIES=2
OCR_SPACE_RETRY_DELAY_SECONDS=2

# ===== Translation fallback =====
HELSINKI_DEVANAGARI_FALLBACK=false

# ===== SMTP (optional for draft emailing) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
