# ===== Core =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FIREBASE_SERVICE_ACCOUNT_PATH=
SHARE_LINK_SECRET=

# ===== LLM Provider =====
# LLM provider is fixed to Groq.

# ===== Groq =====
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

GROQ_TEMPERATURE=0.2
GROQ_MAX_RETRIES=2
GROQ_REQUEST_TIMEOUT=60

# ===== Oracle DB =====
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_CONFIG_DIR=/app/wallet
ORACLE_WALLET_LOCATION=/app/wallet
ORACLE_WALLET_PASSWORD=

# ===== Public link settings =====
APP_PUBLIC_BASE_URL=http://127.0.0.1:8001
LEGAL_SOURCE_BASE_URL=

# ===== Indian Kanoon =====
ENABLE_INDIAN_KANOON_LINKS=true
INDIAN_KANOON_MAX_LINKS=3
INDIAN_KANOON_TRIGGER_MODE=case_queries

# ===== OCR =====
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=
OCR_SPACE_LANGUAGE=auto
OCR_SPACE_ENGINE=3
OCR_SPACE_TIMEOUT_SECONDS=45
OCR_SPACE_MAX_RETRIES=2
OCR_SPACE_RETRY_DELAY_SECONDS=2

# ===== Translation fallback =====
HELSINKI_DEVANAGARI_FALLBACK=mr

# ===== Qdrant =====
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=indian_law_v2
QDRANT_PREFER_GRPC=true

# ===== Embeddings =====
BGE_DEVICE=cpu
BGE_USE_FP16=false
BGE_BATCH_SIZE=4
BGE_MAX_LENGTH=1024

# ===== Retrieval =====
QDRANT_ENABLE_HYBRID=true
QDRANT_ENABLE_RERANKER=true

# ===== Reranker =====
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_USE_FP16=false
RERANKER_CANDIDATE_LIMIT=12
RERANKER_FINAL_LIMIT=8
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=768

# ===== SMTP (optional for draft emailing) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
